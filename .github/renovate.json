{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "helpers:pinGitHubActionDigestsToSemver",
    ":gitSignOff",
    "group:recommended",
    "group:monorepos"
  ],
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "1 day",
  "osvVulnerabilityAlerts": true,
  "gitIgnoredAuthors": [
    "133648757+glasskube-bot@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "Automerge minor and patch releases of GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "groupName": "Kotlin",
      "matchPackageNames": [
        "org.jetbrains.kotlin{/,}**"
      ]
    }
  ]
}
